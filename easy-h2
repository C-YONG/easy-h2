#!/bin/bash
# ═══════════════════════════════════════════════════════════════
# easy-h2 — Three-tool heritability estimation for multiple variant types
# 
# Usage:
#   easy-h2 [--out DIR] single <VCF> <pheno.csv> <SNP|INDEL|SV>
#   easy-h2 [--out DIR] batch <snp.vcf> <indel.vcf> <sv.vcf> <pheno.csv>
#   easy-h2 install
#
# Phenotype CSV: FID, trait1, trait2, ... (header, NA=missing)
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINDIR="$SCRIPT_DIR/bin"
LIBDIR="$SCRIPT_DIR/lib"

# ── Parse ──
# Defaults
OUTDIR="./easy-h2-out"
TRAIT_COL=1
MAF_SNP=0.05; GENO_SNP=0.05
MAF_INDEL=0.05; GENO_INDEL=0.05
MAF_SV=0.01; GENO_SV=0.20

# Parse flags (before command)
while [[ $# -gt 0 ]]; do
    case "$1" in
        --out) OUTDIR="$2"; shift 2;;
        --trait) TRAIT_COL="$2"; shift 2;;
        -h|--help) CMD=help; shift;;
        *) break;;
    esac
done

CMD="${1:-help}"
shift 2>/dev/null || true

# ── help (no tools needed) ──
if [ "$CMD" = "help" ] || [ "$CMD" = "-h" ] || [ "$CMD" = "--help" ]; then
    cat << 'HELP'
easy-h2 — Heritability estimation with GCTA + GEMMA + LDAK

Usage:
  easy-h2 [--out DIR] [--trait N] single <VCF> <pheno.csv> <SNP|INDEL|SV>
  easy-h2 [--out DIR] [--trait N] batch  <snp.vcf> <indel.vcf> <sv.vcf> <pheno.csv>
  easy-h2 install

Options:
  --out DIR       Output directory (default: ./easy-h2-out)
  --trait N       Trait column in CSV (0=FID, 1=first trait, default: 1)

Phenotype CSV format:
  FID,trait1,trait2,...
  101,1.2,3.4
  102,NA,2.1
HELP
    exit 0
fi

# ── install (no tools needed) ──
if [ "$CMD" = "install" ]; then
    bash "$SCRIPT_DIR/install.sh"
    exit 0
fi

# ── find tools ──
find_tool() {
    for p in "$BINDIR/$1" "$(which "$1" 2>/dev/null)" "$SCRIPT_DIR/$1"; do
        if [ -x "$p" ]; then echo "$p"; return 0; fi
    done
    echo "ERROR: $1 not found. Run 'easy-h2 install' first." >&2
    exit 1
}

export BCFTOOLS="${BCFTOOLS:-$(which bcftools 2>/dev/null || echo bcftools)}"
export PLINK="${PLINK:-$(which plink2 2>/dev/null || echo plink2)}"
GCTA=$(find_tool gcta64)
GEMMA=$(find_tool gemma)
LDAK=$(find_tool ldak6.2)

# ── help ──




# ── single ──
if [ "$CMD" = "single" ]; then
    VCF="$1"; PHENO="$2"; TYPE="${3:-SNP}"
    bash "$SCRIPT_DIR/lib/run_one.sh" "$VCF" "$PHENO" "$TYPE" "$OUTDIR" "$TRAIT_COL" \
        "$GCTA" "$GEMMA" "$LDAK" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    exit 0
fi

# ── batch ──
if [ "$CMD" = "batch" ]; then
    SNP_VCF="$1"; INDEL_VCF="$2"; SV_VCF="$3"; PHENO="$4"
    echo "═══ easy-h2 batch ═══"
    bash "$SCRIPT_DIR/lib/run_one.sh" "$SNP_VCF"   "$PHENO" SNP   "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$LDAK" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    bash "$SCRIPT_DIR/lib/run_one.sh" "$INDEL_VCF" "$PHENO" INDEL "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$LDAK" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    bash "$SCRIPT_DIR/lib/run_one.sh" "$SV_VCF"    "$PHENO" SV    "$OUTDIR" "$TRAIT_COL" "$GCTA" "$GEMMA" "$LDAK" "$MAF_SNP" "$GENO_SNP" "$MAF_INDEL" "$GENO_INDEL" "$MAF_SV" "$GENO_SV"
    echo ""; echo "═══ RESULTS ═══"
    cat "$OUTDIR/summary.tsv"
    exit 0
fi

echo "Unknown command: $CMD. Try 'easy-h2 help'."
exit 1
